# BSA V2 Web 工作台环境变量样例
# 复制为 /etc/bsa-web.env（systemd EnvironmentFile 读取）后按注释填写。
#   cp .env.example /etc/bsa-web.env && chmod 600 /etc/bsa-web.env && vim /etc/bsa-web.env
# 变更后：systemctl restart bsa-web

# ---------- Web 平台（bsa_web）----------

# 平台监听端口（nginx 443 → 127.0.0.1:8888）
BSA_WEB_PORT=8888

# 会话 cookie 有效期（秒），默认 8 小时
SESSION_TTL_SEC=28800

# HTTPS 下必须为 true（cookie 加 Secure；本地 http 调试可 false）
COOKIE_SECURE=true

# 平台 DB / 访问日志根目录（platform.sqlite3、access.log 都在其中）
LOG_DIR=logs

# 签名密钥：必须显式配置非空随机值；缺失时平台拒绝启动
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 静态账号：JSON 字典 {username: "bcrypt哈希:role"}（role=admin 管理员 / operator 操作者 / viewer 查看者），
# 整体须为合法 JSON。生成示例（替换为真实密码与哈希后粘贴到 BSA_USERS）：
#   python -c "import bcrypt,json;print(json.dumps({'alice':bcrypt.hashpw(b'op',bcrypt.gensalt()).decode()+':admin'}))"
# 注意：bcrypt 哈希含 $；systemd EnvironmentFile 中 $ 需写为 $$（如 $2b$12$… → $$2b$$12$$…）。
# 注意：BSA_USERS 仅在平台首启（users 表为空）时引导入库；此后账号增删改一律走管理员
# 在「设置」页操作并持久化到 platform.sqlite3，重启不会复活 env 中已删除的账号。
BSA_USERS={"alice": "REPLACE_WITH_BCRYPT_HASH:admin"}

# 自助登记（JIT 建号）：登录时用户名尚未存在且密码命中 BSA_SIGNUP_PASSWORD 即自动建号，
# 默认角色 operator；白名单 BSA_SIGNUP_ADMIN_USERS 内的用户名建为 admin（JSON 数组）。
# 留空 = 关闭该功能。示例：raisecom 口令 + yuhui/yangfu 管理员。
#   BSA_SIGNUP_PASSWORD=raisecom
#   BSA_SIGNUP_ADMIN_USERS=["yuhui","yangfu"]

# ---------- V1 Agent（bsa，由平台子进程调用 / 每日 cron 读取）----------

# 仓库与 worktree
REPO_PATH=/path/to/rcios
# 完整分支清单：服务手动同步的编译型号解析与平台工作台的源/目标下拉。
BRANCH_FILE=/path/to/branch.md
# cron 周期专用分支文件：只有它决定每日同步拓扑（章节标题需带「主分支」/「业务分支」
# 标注，业务→主单向）。留空则回退 BRANCH_FILE。
# 注意：BRANCH_FILE 指向完整清单时必须显式配置本项，否则完整清单解析不出同步边，
# cron 会扫描面为空（引擎会在 detect_commits 报错提示，不会静默空跑）。
CRON_BRANCH_FILE=/path/to/branch-cron.md
WORKTREE_ROOT=/srv/bsa/worktrees

# LLM 决策
LLM_BACKEND=api
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# CLAUDE_CLI_PATH=claude
# LLM_BACKEND=claude_cli 时：claude -p 子进程的认证上下文（JSON dict）。
# executor 是 systemd 守护进程，不会 source 用户 shell，.bashrc 里的 ANTHROPIC_*/DEEPSEEK_*
# 对子进程不可见 → claude 拿不到认证而失败。把这些变量显式写进这里，由引擎注入 claude 子进程 env。
#   CLAUDE_CLI_ENV={"ANTHROPIC_API_KEY":"sk-ant-...","ANTHROPIC_BASE_URL":"https://api.deepseek.com/anthropic","ANTHROPIC_AUTH_TOKEN":"sk-...","ANTHROPIC_MODEL":"..."}
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=3
LLM_DEGRADE_TO_MANUAL=true

# Docker 编译
DOCKER_PREFIX=
DOCKER_IMAGE=
# DOCKER_CONTAINER_PREFIX=rcios-sync
DOCKER_MOUNT_WORKSPACE=
# DOCKER_USER=

# 构建
BUILD_SCRIPT_DIR=/path/to/build-scripts
# MAX_CONFLICT_ATTEMPTS=5
# MAX_CONFLICT_CONTEXT_CHARS=50000
# MAX_BUILD_ATTEMPTS=3
# MAX_BUILD_CONTEXT_CHARS=50000

# 邮件报告
# MAIL_DRY_RUN=true
MAIL_SENDER=
# 正式周期正常收件人（回退名单）
MAIL_RECIPIENTS=["ops@example.com"]
# 项目经理名单（周期报告收件人）；空则回退 MAIL_RECIPIENTS；有失败/报错时引擎会
# 追加失败 commit 的合入人邮箱与模块负责人邮箱，三者去重
# MAIL_PM_RECIPIENTS=[]
# 模块负责人映射 JSON 路径（见 spec/module_owner_map.json，键 module_owner_map）；
# 留空 = 负责人维度关闭（老部署零改动）。非空时失败/报错周期除合入人外，再追加失败
# commit 改动文件「最长目录前缀命中」的全部模块负责人邮箱
# MODULE_OWNER_MAP_PATH=
# bridge 收件阶段过滤：test/dev 硬帽到测试白名单；正式发 PM 需配 prod
# MAIL_PHASE=test
# MAIL_BRIDGE_PATH=

# 扫描窗口 / 重试 / fail-fast（有默认值，可留空）
# SCAN_SINCE=
# SCAN_UNTIL=
# FETCH_RETRY_COUNT=3
# FETCH_RETRY_BASE_SEC=30
# FAILFAST_REGION_GAP=200
