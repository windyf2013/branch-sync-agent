# BSA V2 Web 工作台环境变量样例
# 复制为 /etc/bsa-web.env（systemd EnvironmentFile 读取）后按注释填写。
#   cp .env.example /etc/bsa-web.env && chmod 600 /etc/bsa-web.env && vim /etc/bsa-web.env
# 变更后：systemctl restart bsa-web

# ---------- Web 平台（bsa_web）----------

# 平台监听端口（nginx 443 → 127.0.0.1:8888）
BSA_WEB_PORT=8888

# 会话 cookie 有效期（秒），默认 8 小时
SESSION_TTL_SEC=28800

# HTTPS 下必须为 true（cookie 加 Secure；本地 http 调试可 false）
COOKIE_SECURE=true

# 平台 DB / 访问日志根目录（platform.sqlite3、access.log 都在其中）
LOG_DIR=logs

# 签名密钥：必须显式配置非空随机值；缺失时平台拒绝启动
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 静态账号：JSON 字典 {username: "bcrypt哈希:role"}（role=operator 操作者 / viewer 查看者），
# 整体须为合法 JSON。生成示例（替换为真实密码与哈希后粘贴到 BSA_USERS）：
#   python -c "import bcrypt,json;print(json.dumps({'alice':bcrypt.hashpw(b'op',bcrypt.gensalt()).decode()+':operator'}))"
# 注意：bcrypt 哈希含 $；systemd EnvironmentFile 中 $ 需写为 $$（如 $2b$12$… → $$2b$$12$$…）。
BSA_USERS={"alice": "REPLACE_WITH_BCRYPT_HASH:operator"}

# ---------- V1 Agent（bsa，由平台子进程调用 / 每日 cron 读取）----------

# 仓库与 worktree
REPO_PATH=/path/to/rcios
BRANCH_FILE=/path/to/branch.md
WORKTREE_ROOT=/srv/bsa/worktrees

# LLM 决策
LLM_BACKEND=api
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# CLAUDE_CLI_PATH=claude
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=3
LLM_DEGRADE_TO_MANUAL=true

# Docker 编译
DOCKER_PREFIX=
DOCKER_IMAGE=
# DOCKER_CONTAINER_PREFIX=rcios-sync
DOCKER_MOUNT_WORKSPACE=
# DOCKER_USER=

# 构建
BUILD_SCRIPT_DIR=/path/to/build-scripts
# MAX_CONFLICT_ATTEMPTS=3
# MAX_BUILD_ATTEMPTS=3

# 邮件报告
# MAIL_DRY_RUN=true
MAIL_SENDER=
MAIL_RECIPIENTS=["ops@example.com"]
# MAIL_BRIDGE_PATH=

# 扫描窗口 / 重试 / fail-fast（有默认值，可留空）
# SCAN_SINCE=
# SCAN_UNTIL=
# FETCH_RETRY_COUNT=3
# FETCH_RETRY_BASE_SEC=30
# FAILFAST_REGION_GAP=200
