# bsa-web.service — BSA V2 Web 分支维护工作台（用户级 systemd 服务）
#
# 纯管理/UI 层：不 spawn CLI、不持有执行线程；任务执行由 bsa-executor 负责。
#
# 部署位置（用户级，Linger 开启后开机自启）：
#   mkdir -p ~/.config/systemd/user
#   cp deploy/bsa-web.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now bsa-web
# 注意：项目 .env 从 WorkingDirectory 读取，此服务必须与 bsa-executor 使用同一目录。

[Unit]
Description=BSA V2 Web 分支维护工作台
After=network-online.target
Wants=network-online.target
After=bsa-executor.service
Wants=bsa-executor.service

[Service]
Type=simple
WorkingDirectory=%h/projects/branch-sync-agent/.worktrees/feat-v3-eng-custom
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/projects/branch-sync-agent/.worktrees/feat-v3-eng-custom/.venv/bin/uvicorn bsa_web.app:create_app --factory --host 10.10.100.161 --port 8888
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=default.target
